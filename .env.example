# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# app/config.js 가 시작할 때 .env 를 읽는다. 별도 명령은 필요 없다.
# 비워 두면 각 항목의 기본값으로 동작한다. 로컬 시연은 전부 비워 둬도 된다.


# ── 체인 ─────────────────────────────────────────────────────────────────────

# Anchor Contract를 올리고 읽을 체인.
# 비우면 로컬 anvil(http://127.0.0.1:8545)을 쓴다.
# Sepolia에 올릴 때만 채운다.
ANCHOR_RPC_URL=

# 앵커링 트랜잭션에 서명할 키. Root를 기록하는 수취은행 역할이다.
#
# 경고: 시험망 전용 키만 쓴다. 실제 자산이 있는 지갑의 키를 여기 넣지 않는다.
#      이 값이 있으면 누구든 우리 은행 이름으로 Root를 올릴 수 있다.
# 비우면 anvil의 첫 계정을 쓴다. 로컬 밖에서는 반드시 채운다.
ANCHOR_ISSUER_KEY=

# 이미 올라가 있는 컨트랙트를 가리킬 때만 쓴다.
# 비우면 배포 스크립트가 남긴 build/anchor.json 의 주소를 읽는다.
ANCHOR_ADDRESS=

# 앵커링할 때 읽을 배포 결과 파일. 레포 기준 상대경로다.
# 로컬은 비워 둔다(build/anchor.json). 공개망에 앵커링할 때만 지정한다.
#   ANCHOR_INFO=build/anchor.sepolia.infura.io.json
ANCHOR_INFO=


# ── 수취은행 비밀 ────────────────────────────────────────────────────────────

# 계좌 참조값을 유도하는 은행 비밀키. 이 값이 바뀌면 트리 전체와 Root가 바뀐다.
# 팀원과 같은 Root를 내려면 같은 값을 써야 한다.
# 비우면 데모용 고정값을 쓴다. 운영에서는 HSM이나 KMS에 둔다.
BANK_SECRET=


# ── 시간값 (초) ──────────────────────────────────────────────────────────────
# 평소에는 비워 둔다. 만료나 유예를 눈으로 확인할 때만 줄여서 쓴다.

# Root 유효기간. 기본 300. 시연이 길어지면 늘린다.
#   ROOT_PERIOD_SECONDS=1800
ROOT_PERIOD_SECONDS=

# 회차 교체 뒤 직전 회차를 받아 주는 유예. 기본 60.
GRACE_SECONDS=

# 증명의 검증 시각과 지금 시각의 허용 오차. 기본 120.
CLOCK_SKEW_SECONDS=

# 발급한 nonce의 수명. 기본 120.
NONCE_TTL_SECONDS=
